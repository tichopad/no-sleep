{
	"name": "no-sleep",
	"type": "module",
	"author": {
		"name": "tichopad"
	},
	"repository": {
		"url": "https://github.com/tichopad/no-sleep"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@girs/gjs": "4.0.1",
		"@girs/gnome-shell": "46.0.2",
		"@vitest/coverage-v8": "3.2.6",
		"typescript": "6.0.3",
		"vitest": "^3.2.1"
	},
	"scripts": {
		"build:schemas": "glib-compile-schemas schemas/",
		"typecheck": "tsc --noEmit -p ./jsconfig.json",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	}
}
